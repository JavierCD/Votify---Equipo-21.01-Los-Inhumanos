@page "/dashboard-participante/{Id:int}"
@rendermode InteractiveServer

@using Votify.Core.Models
@using Votify.Core.Interfaces
@using Votify.Services.Interfaces
@using Votify.Web.Services

@inject IParticipanteService ParticipanteService
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject UserSession UserSession

<PageTitle>Mi Centro de Mando - Votify</PageTitle>

@if (cargando)
{
    <div class="container rz-mt-4 rz-text-align-center">
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mt-4">Cargando tus participaciones...</RadzenText>
    </div>
}
else if (participante == null)
{
    <div class="container rz-mt-4">
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">
            No se ha podido cargar la información de tu perfil en este momento.
        </RadzenAlert>
    </div>
}
else
{
    <div class="container rz-mt-4 rz-mb-5">

        @* --- CABECERA DE PERFIL --- *@
        <RadzenCard class="rz-mb-4 rz-shadow-2" Style="border-left: 4px solid var(--rz-primary);">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <div>
                    <RadzenText TextStyle="TextStyle.H4" class="rz-m-0 fw-bold">Hola, @participante.Name 👋</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body1" class="text-muted rz-m-0">Panel del Participante | @participante.Email</RadzenText>
                </div>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem">
                    <RadzenButton Icon="travel_explore" Text="Explorar Hackathons" ButtonStyle="ButtonStyle.Secondary" Click="@(() => NavManager.NavigateTo("/"))" />
                    <RadzenButton Icon="manage_accounts" Text="Mi Perfil" ButtonStyle="ButtonStyle.Primary" Click="@(() => NavManager.NavigateTo($"/ficha-participante/{participante.Id}"))" />
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>

        @if (participante.Proyectos?.Any() != true)
        {
            <div class="text-center rz-mt-5 rz-mb-5 p-5 bg-light rounded border border-dashed shadow-sm">
                <RadzenIcon Icon="rocket_launch" Style="font-size: 4rem; color: #cbd5e1;" class="rz-mb-3" />
                <RadzenText TextStyle="TextStyle.H5" class="fw-bold text-dark">Tu panel está en blanco</RadzenText>
                <RadzenText TextStyle="TextStyle.Body1" class="text-muted rz-mb-4" Style="max-width: 500px; margin: 0 auto;">Inscribe un proyecto en alguno de los eventos disponibles para empezar a competir y recibir feedback del jurado.</RadzenText>
                <RadzenButton Text="Buscar Eventos" Icon="search" ButtonStyle="ButtonStyle.Primary" Click="@(() => NavManager.NavigateTo("/"))" />
            </div>
        }
        else
        {
            @* ========================================================
               SECCIÓN 1: PROYECTOS ACTIVOS / EN COMPETICIÓN
               ======================================================== *@
            var proyectosActivos = participante.Proyectos.Where(p => !TodosEventosCerrados(p)).ToList();

            <h5 class="fw-bold text-secondary mb-3"><RadzenIcon Icon="bolt" class="text-warning me-1" /> Proyectos en Competición</h5>

            @if (!proyectosActivos.Any())
            {
                <div class="alert alert-light border shadow-sm text-muted fst-italic mb-5">No tienes proyectos en competiciones activas en este momento.</div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 g-4 mb-5">
                    @foreach (var proyecto in proyectosActivos)
                    {
                        var categoriaPrincipal = proyecto.Categorias?.FirstOrDefault();
                        var eventoPrincipal = categoriaPrincipal?.Evento;

                        <div class="col">
                            <div class="card h-100 shadow-sm border-0 border-top border-4 border-info">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h5 class="fw-bold mb-0">@proyecto.Name</h5>
                                        <span class="badge bg-success rounded-pill">En Curso</span>
                                    </div>
                                    <p class="text-muted small mb-3">
                                        <RadzenIcon Icon="event" Style="font-size: 14px;" /> @(eventoPrincipal?.Name ?? "Evento Desconocido") <br />
                                        <RadzenIcon Icon="category" Style="font-size: 14px;" /> @(categoriaPrincipal?.Name ?? "Categoría General")
                                    </p>

                                    <div class="d-flex flex-column gap-2 mt-4">
                                        <RadzenButton Text="Ver Competición (Ranking)" Icon="emoji_events" ButtonStyle="ButtonStyle.Light" class="w-100 text-start"
                                                      Click="@(() => NavManager.NavigateTo($"/panel-evento/{eventoPrincipal?.Id}"))" Disabled="@(eventoPrincipal == null)" />

                                        <RadzenButton Text="Ver Mi Feedback" Icon="assessment" ButtonStyle="ButtonStyle.Info" class="w-100 text-start text-white fw-bold"
                                                      Click="@(() => NavManager.NavigateTo($"/evaluacion-proyecto/{proyecto.Id}"))" />

                                        <RadzenButton Text="Hoja de Ruta IA" Icon="psychology" ButtonStyle="ButtonStyle.Success" class="w-100 text-start"
                                                      Click="@(() => NavManager.NavigateTo($"/hoja-ruta/{proyecto.Id}"))" />

                                        <RadzenButton Text="Editar Proyecto" Icon="edit_note" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" class="w-100 text-start"
                                                      Click="@(() => NavManager.NavigateTo($"/participante/editar-proyecto/{proyecto.Id}"))" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            @* ========================================================
               SECCIÓN 2: HISTORIAL / PROYECTOS FINALIZADOS
               ======================================================== *@
            var proyectosFinalizados = participante.Proyectos.Where(p => TodosEventosCerrados(p)).ToList();

            <h5 class="fw-bold text-secondary mb-3 mt-5"><RadzenIcon Icon="inventory_2" class="text-muted me-1" /> Historial de Participaciones</h5>

            @if (!proyectosFinalizados.Any())
            {
                <div class="alert alert-light border shadow-sm text-muted fst-italic">Tus proyectos completados aparecerán aquí.</div>
            }
            else
            {
                <div class="list-group shadow-sm border-0">
                    @foreach (var proyecto in proyectosFinalizados)
                    {
                        var categoriasCerradas = proyecto.Categorias?.Where(c => c.Votacion?.ResultadosPublicados == true).ToList() ?? new List<Categoria>();
                        // Usamos la categoría principal para sacar el evento, o la primera del proyecto si no hay cerradas
                        var eventoPrincipal = categoriasCerradas.FirstOrDefault()?.Evento ?? proyecto.Categorias?.FirstOrDefault()?.Evento;

                        <div class="list-group-item p-4 bg-white border mb-3 rounded shadow-sm">

                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h6 class="fw-bold mb-1">@proyecto.Name</h6>
                                    <span class="text-muted small d-block mb-3">Finalizado en @(eventoPrincipal?.Name ?? "Evento Desconocido")</span>

                                    <RadzenButton Text="Ver Podio Final" Icon="emoji_events" ButtonStyle="ButtonStyle.Warning" class="text-dark fw-bold shadow-sm" Size="ButtonSize.Small"
                                                  Click="@(() => NavManager.NavigateTo($"/panel-evento/{eventoPrincipal?.Id}"))" Disabled="@(eventoPrincipal == null)" />
                                </div>

                                <RadzenButton Text="Informe Final" Icon="analytics" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Size="ButtonSize.Small"
                                              Click="@(() => NavManager.NavigateTo($"/evaluacion-proyecto/{proyecto.Id}"))" />
                            </div>

                            @* CERTIFICADOS OFICIALES *@
                            @if (categoriasCerradas.Any())
                            {
                                <div class="bg-light p-3 rounded border mt-2">
                                    <span class="d-block small fw-bold text-muted border-bottom pb-2 mb-2">Tus Certificados Oficiales</span>

                                    @foreach (var cat in categoriasCerradas)
                                    {
                                        int miPosicion = ObtenerPosicionProyecto(proyecto, cat);

                                        <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                                            <span class="small text-dark">
                                                <RadzenIcon Icon="label" Style="font-size: 14px;" class="me-1 text-muted" /> @cat.Name
                                                <strong class="ms-1 text-primary">@(miPosicion > 0 ? $"(Posición: {miPosicion}º)" : "")</strong>
                                            </span>

                                            <div class="d-flex gap-2">
                                                <RadzenButton Text="Participación" Icon="verified" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.ExtraSmall" Variant="Variant.Outlined"
                                                              Click="@(() => AbrirCertificadoParticipacion(proyecto, cat))" />

                                                @if (miPosicion > 0 && miPosicion <= 3)
                                                {
                                                    <RadzenButton Text="Premio" Icon="emoji_events" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall"
                                                                  Click="@(() => AbrirCertificado(proyecto, cat, miPosicion))" />
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Participante? participante;
    private bool cargando = true;

    protected override async Task OnParametersSetAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            cargando = true;
            participante = await ParticipanteService.ObtenerDashboardAsync(Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar el dashboard: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

    private bool TodosEventosCerrados(Proyecto proyecto)
    {
        if (proyecto.Categorias == null || !proyecto.Categorias.Any()) return false;
        return proyecto.Categorias.All(c => c.Votacion != null && c.Votacion.ResultadosPublicados);
    }

    // ==========================================
    // LÓGICA DE CERTIFICADOS (MANTENIDA ORIGINAL)
    // ==========================================
    async Task AbrirCertificado(Proyecto proyecto, Categoria categoria, int posicion)
    {
        var nombreEquipo = proyecto.Name;
        var integrantes = new List<string> { proyecto.Participante?.Name ?? participante!.Name };
        var integrantesString = string.Join(";", integrantes);
        var evento = categoria.Name;

        await JS.InvokeVoidAsync(
            "open",
            $"/certificado?" +
            $"nombreEquipo={Uri.EscapeDataString(nombreEquipo)}" +
            $"&integrantes={Uri.EscapeDataString(integrantesString)}" +
            $"&posicion={posicion}" +
            $"&evento={Uri.EscapeDataString(evento)}",
            "_blank"
        );
    }

    async Task AbrirCertificadoParticipacion(Proyecto proyecto, Categoria? categoria)
    {
        if (categoria == null) return;

        var nombreParticipante = participante!.Name;
        var nombreProyecto = proyecto.Name;
        var nombreEvento = categoria.Evento?.Name ?? "Evento Votify";
        var fechaParticipacion = proyecto.FechaRegistro;

        await JS.InvokeVoidAsync(
            "open",
            $"/certificado-participacion?" +
            $"nombreParticipante={Uri.EscapeDataString(nombreParticipante)}" +
            $"&nombreProyecto={Uri.EscapeDataString(nombreProyecto)}" +
            $"&nombreEvento={Uri.EscapeDataString(nombreEvento)}" +
            $"&fechaParticipacion={fechaParticipacion:yyyy-MM-dd}",
            "_blank"
        );
    }

    // ==========================================
    // LÓGICA DE CÁLCULO DE POSICIONES INTERNA
    // ==========================================
    private int ObtenerPosicionProyecto(Proyecto proyecto, Categoria categoria)
    {
        if (categoria.Votacion == null || categoria.Votacion.Votos == null || !categoria.Proyectos.Any()) return 0;

        var votos = categoria.Votacion.Votos;
        var esMulticriterio = categoria.Votacion is Multicriterio;
        var mc = categoria.Votacion as Multicriterio;

        List<dynamic> ranking;
        if (esMulticriterio)
        {
            ranking = categoria.Proyectos
                .Select(p => new
                {
                    ProyectoId = p.Id,
                    Puntuacion = CalcularPuntuacionMulticriterio(votos.Where(v => v.ProyectoId == p.Id).ToList(), mc)
                })
                .OrderByDescending(x => x.Puntuacion)
                .Cast<dynamic>()
                .ToList();
        }
        else if (categoria.Votacion is Popular)
        {
            ranking = categoria.Proyectos
                .Select(p => new
                {
                    ProyectoId = p.Id,
                    Votos = votos.Count(v => v.ProyectoId == p.Id)
                })
                .OrderByDescending(x => x.Votos)
                .Cast<dynamic>()
                .ToList();
        }
        else
        {
            ranking = categoria.Proyectos
                .Select(p => new
                {
                    ProyectoId = p.Id,
                    Puntos = votos.Where(v => v.ProyectoId == p.Id).Sum(v => v.PuntuacionBase)
                })
                .OrderByDescending(x => x.Puntos)
                .Cast<dynamic>()
                .ToList();
        }

        int index = ranking.FindIndex(r => ((dynamic)r).ProyectoId == proyecto.Id);
        return index >= 0 ? index + 1 : 0;
    }

    private double CalcularPuntuacionMulticriterio(List<Voto> votos, Multicriterio? votacion)
    {
        if (votacion == null || votacion.Criterios == null || !votacion.Criterios.Any()) return 0;

        double sumaPonderada = 0;
        int votosValidos = 0;

        foreach (var voto in votos)
        {
            if (!voto.Detalles.Any()) continue;

            double puntajeVoto = 0;
            double pesoTotalUsado = 0;

            foreach (var detalle in voto.Detalles)
            {
                var criterio = votacion.Criterios.FirstOrDefault(c => c.Id == detalle.CriterioId);
                if (criterio != null && criterio.Peso > 0)
                {
                    puntajeVoto += detalle.Puntuacion * (criterio.Peso / 100.0);
                    pesoTotalUsado += criterio.Peso;
                }
            }

            if (pesoTotalUsado > 0 && pesoTotalUsado < 100)
            {
                puntajeVoto *= (100.0 / pesoTotalUsado);
            }

            sumaPonderada += puntajeVoto;
            votosValidos++;
        }

        return votosValidos > 0 ? sumaPonderada / votosValidos : 0;
    }
}