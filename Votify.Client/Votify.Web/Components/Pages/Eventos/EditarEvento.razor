                // El modelo de dominio hace el cálculo
                cat.Votacion.EvaluarEstadoTemporal(ahora);

                // Si el estado de dominio cambió mágicamente por el paso del tiempo
                if (estadoAnterior != cat.Votacion.Estado)
                {
                    cambioDetectado = true;
                    // NOTA: Podrías llamar al servicio aquí para guardar el nuevo estado en BD
                    // si lo consideras estrictamente necesario, aunque al estar el cálculo
                    // basado en fechas, no es 100% obligatorio persistir el string inmediatamente.
