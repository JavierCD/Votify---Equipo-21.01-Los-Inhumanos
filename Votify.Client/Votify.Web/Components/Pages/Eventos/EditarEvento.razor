@page "/eventos/editar/{EventoId:int}"
@rendermode InteractiveServer
@implements IDisposable
@using System.Text
@using Votify.Core.Factories
@using Votify.Core.Interfaces
@using Votify.Core.Models
@using Votify.Services.Interfaces
@using Votify.Services.Models
@using Votify.Services.Models.Requests
@using Votify.Services.Models.Responses
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService
@inject IEventoService EventoService
@inject ICategoriaService CategoriaService
@inject IEmailService EmailService
@* NUEVA INYECCIÓN PARA LISTAR JUECES 
@inject IGenericRepository<Juez> JuezRepository *@
@inject IAuditoriaService AuditoriaService
@inject IResultadosService ResultadosService
@inject IVotacionService VotacionService
@inject ISupervisionService SupervisionService
@inject IUnitOfWork _unitOfWork


<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Gestión del Evento: <span class="text-primary">@(evento?.Name ?? "Cargando...")</span></h2>
        <button class="btn btn-outline-secondary" @onclick='() => NavigationManager.NavigateTo("/")'>Volver al Dashboard</button>
    </div>

    @if (evento == null)
    {
        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando...</span></div>
    }
    else
    {
        <ul class="nav nav-tabs mb-4">
            <li class="nav-item">
                <a class="nav-link @(tabActivo == "Generales" ? "active fw-bold" : "")" @onclick='() => tabActivo = "Generales"' style="cursor:pointer">
                    <RadzenIcon Icon="edit_note" class="me-1" /> Datos Generales
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(tabActivo == "Categorias" ? "active fw-bold" : "")" @onclick='() => tabActivo = "Categorias"' style="cursor:pointer">
                    <RadzenIcon Icon="category" class="me-1" /> Categorías y Votaciones
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(tabActivo == "Participantes" ? "active fw-bold" : "")" @onclick='() => tabActivo = "Participantes"' style="cursor:pointer">
                    <RadzenIcon Icon="groups" class="me-1" /> Participantes
                </a>
            </li>
            @* NUEVA PESTAÑA DE JURADO *@
            <li class="nav-item">
                <a class="nav-link @(tabActivo == "Jurado" ? "active fw-bold" : "")" @onclick='() => tabActivo = "Jurado"' style="cursor:pointer">
                    <RadzenIcon Icon="gavel" class="me-1" /> Jurado
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(tabActivo == "Auditoria" ? "active fw-bold" : "")" @onclick='() => CambiarTab("Auditoria")' style="cursor:pointer">
                    <RadzenIcon Icon="verified_user" class="me-1" /> Auditoría
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(tabActivo == "Resultados" ? "active fw-bold" : "")" @onclick='() => CambiarTab("Resultados")' style="cursor:pointer">
                    <RadzenIcon Icon="emoji_events" class="me-1" /> Resultados
                </a>
            </li>
        </ul>

        @* MENSAJES GLOBALES DE ÉXITO Y ERROR *@
        @if (!string.IsNullOrEmpty(mensajeExito))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <RadzenIcon Icon="check_circle" class="me-1" /> @mensajeExito
                <button type="button" class="btn-close" @onclick="() => mensajeExito = null"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <RadzenIcon Icon="error" class="me-1" /> @mensajeError
                <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
            </div>
        }

        @if (tabActivo == "Generales")
        {
            <div class="card shadow-sm p-4" style="max-width: 600px;">
                <h4 class="mb-4">Información Principal</h4>

                <div class="mb-3">
                    <label class="form-label fw-bold">Nombre del Evento</label>
                    <input type="text" class="form-control" @bind="requestModel.Name" />
                </div>
                <div class="row mb-3">
                    <div class="col">
                        <label class="form-label fw-bold">Fecha de Inicio</label>
                        <input type="date" class="form-control" @bind="fechaInicioTemp" />
                    </div>
                    <div class="col">
                        <label class="form-label fw-bold">Fecha de Fin</label>
                        <input type="date" class="form-control" @bind="fechaFinTemp" />
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-bold">Descripción / Reglas</label>
                    <textarea class="form-control" rows="4" @bind="requestModel.Description"></textarea>
                </div>
                <button class="btn btn-primary" @onclick="GuardarDatosGenerales">Guardar Cambios</button>
            </div>
        }

        else if (tabActivo == "Categorias")
        {
            <div class="row">
                <div class="col-12">
                    @foreach (var categoria in evento.CategoriasEvento.ToList())
                    {
                        <div class="card mb-4 shadow-sm border-start border-primary border-4">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">@categoria.Name</h5>
                            </div>
                            <div class="card-body row">

                                <div class="col-md-5 border-end">
                                    <h6>
                                        Estado de la Votación
                                    </h6>

                                    @if (categoria.Votacion == null)
                                    {
                                        <p class="text-muted small">Aún no hay votación configurada.</p>
                                        <button class="btn btn-sm btn-outline-primary w-100"
                                                @onclick='() => NavigationManager.NavigateTo($"/voto-popular/{evento.Id}/{categoria.Id}")'>
                                            Configurar Votación
                                        </button>
                                    }
                                    else
                                    {
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="text-muted small">
                                                <RadzenIcon Icon="tag" Style="font-size: 14px;" /> ID Votación: <strong>@categoria.Votacion.Id</strong>
                                            </span>
                                        </div>
                                        <!-- 1. SECCIÓN DE FECHAS Y EDICIÓN -->
                                        <div class="bg-light p-2 rounded mb-3 border">
                                            @if (editandoFechas.ContainsKey(categoria.Id) && editandoFechas[categoria.Id])
                                            {
                                                <label class="small fw-bold text-muted">Nueva Apertura:</label>
                                                <RadzenDatePicker @bind-Value="fechasEdicion[categoria.Id].Apertura" ShowTime="true" DateFormat="dd/MM/yyyy HH:mm" class="w-100 mb-2" />

                                                <label class="small fw-bold text-muted">Nuevo Cierre:</label>
                                                <RadzenDatePicker @bind-Value="fechasEdicion[categoria.Id].Cierre" ShowTime="true" DateFormat="dd/MM/yyyy HH:mm" class="w-100 mb-2" />

                                                <div class="d-flex gap-1">
                                                    <button class="btn btn-sm btn-success flex-fill" @onclick="() => GuardarFechasAsync(categoria)">Guardar</button>
                                                    <button class="btn btn-sm btn-outline-secondary flex-fill" @onclick="() => CancelarEdicionFechas(categoria.Id)">Cancelar</button>
                                                </div>
                                            }
                                            else
                                            {
                                                <p class="small mb-1"><strong>Apertura:</strong> @categoria.Votacion.FechaApertura.ToLocalTime().ToString("g")</p>
                                                <p class="small mb-2"><strong>Cierre:</strong> @categoria.Votacion.FechaCierre.ToLocalTime().ToString("g")</p>
                                                <button class="btn btn-sm btn-outline-primary w-100" @onclick="() => IniciarEdicionFechas(categoria)">
                                                    <RadzenIcon Icon="edit_calendar" class="me-1" /> Editar ventanas de tiempo
                                                </button>
                                            }
                                        </div>

                                        <!-- 2. SECCIÓN DE ESTADO ACTUAL -->
                                        <div class="bg-light p-3 rounded mb-3 border">
                                            <RadzenText TextStyle="TextStyle.Subtitle2" class="fw-bold mb-2">Control de Estado:</RadzenText>

                                            <div class="d-flex align-items-center justify-content-between mb-3">
                                                <RadzenBadge BadgeStyle="GetBadgeStyle(categoria.Votacion.Estado)" Text="@categoria.Votacion.Estado" class="fs-6 px-3 py-2" />
                                                <span class="badge bg-success fs-6">@(categoria.Votacion.Votos?.Count ?? 0) votos</span>
                                            </div>

                                            <RadzenDropDown TValue="string"
                                                            Data="@estadosPosibles"
                                                            Value="@categoria.Votacion.Estado"
                                                            ValueChanged="@(args => OnEstadoCambiado(categoria, args.ToString()))"
                                                            Style="width: 100%;"
                                                            Disabled="@categoria.Votacion.ResultadosPublicados" />
                                        </div>

                                        @if (categoria.Votacion.EstaCerrada || categoria.Votacion.Estado == "CerradaManual" || categoria.Votacion.Estado == "Cerrada")
                                        {
                                            @*
                                            <div class="alert alert-success p-2 small d-flex justify-content-between align-items-center">
                                                <span><RadzenIcon Icon="how_to_vote" class="me-1" /> En curso (@categoria.Votacion.Estado)</span>
                                                <span class="badge bg-success">@(categoria.Votacion.Votos?.Count ?? 0) votos</span>
                                            </div> *@

                                            <div class="bg-white border rounded p-2 mb-3">
                                                <strong class="small d-block mb-2 border-bottom pb-1">Clasificación Actual:</strong>

                                                @{
                                                    var votos = categoria.Votacion.Votos;
                                                    var esMulticriterio = categoria.Votacion is Multicriterio;
                                                    var esPopular = categoria.Votacion is Popular;
                                                    var mc = categoria.Votacion as Multicriterio;

                                                    List<dynamic> ranking;
                                                    if (esMulticriterio)
                                                    {
                                                        ranking = categoria.Proyectos
                                                            .Select(p => new
                                                            {
                                                                Proyecto = p,
                                                                Puntuacion = CalcularPuntuacionMulticriterio(
                                                                    votos.Where(v => v.ProyectoId == p.Id).ToList(),
                                                                    mc)
                                                            })
                                                            .OrderByDescending(x => x.Puntuacion)
                                                            .Cast<dynamic>()
                                                            .ToList();
                                                    }
                                                    else if (esPopular)
                                                    {
                                                        ranking = votos
                                                            .GroupBy(v => v.Proyecto)
                                                            .Select(g => new { Proyecto = g.Key, Votos = g.Count() })
                                                            .OrderByDescending(x => x.Votos)
                                                            .Cast<dynamic>()
                                                            .ToList();
                                                    }
                                                    else
                                                    {
                                                        ranking = votos
                                                            .GroupBy(v => v.Proyecto)
                                                            .Select(g => new { Proyecto = g.Key, Puntos = g.Sum(v => v.PuntuacionBase) })
                                                            .OrderByDescending(x => x.Puntos)
                                                            .Cast<dynamic>()
                                                            .ToList();
                                                    }
                                                }

                                                @if (!ranking.Any())
                                                {
                                                    <span class="text-muted small">Nadie votó en esta categoría.</span>
                                                }
                                                else
                                                {
                                                    <ul class="list-unstyled mb-0 small">
                                                        @for (int i = 0; i < Math.Min(3, ranking.Count); i++)
                                                        {
                                                            var posicion = (dynamic)ranking[i];
                                                            string badgeTexto;
                                                            if (esMulticriterio)
                                                            {
                                                                badgeTexto = $"{((double)posicion.Puntuacion):F2} pts";
                                                            }
                                                            else if (esPopular)
                                                            {
                                                                badgeTexto = $"{(int)posicion.Votos} votos";
                                                            }
                                                            else
                                                            {
                                                                badgeTexto = $"{((double)posicion.Puntos):F1} pts";
                                                            }

                                                            <li class="mb-1">
                                                                <strong>@(i + 1)º</strong> @(posicion.Proyecto?.Name ?? "Proyecto Eliminado")
                                                                <span class="badge bg-light text-dark float-end">@badgeTexto</span>
                                                            </li>
                                                        }
                                                    </ul>
                                                }
                                            </div>

                                            <button class="btn btn-sm w-100 fw-bold shadow-sm @(categoria.Votacion.ResultadosPublicados ? "btn-success disabled" : "btn-primary")"
                                                    @onclick="() => CompartirClasificacion(categoria)">

                                                <RadzenIcon Icon="@(categoria.Votacion.ResultadosPublicados ? "check_circle" : "send")" class="me-1" />
                                                @(categoria.Votacion.ResultadosPublicados ? "Clasificación Compartida" : "Compartir Clasificación")
                                            </button>
                                            
                                        }
                                        else
                                        {

                                            <button class="btn btn-sm btn-warning w-100 fw-bold shadow-sm"
                                                    @onclick="() => CerrarVotacionCategoria(categoria.Id)">
                                                <RadzenIcon Icon="lock" class="me-1" /> Forzar Cierre
                                            </button>
                                            
                                        }
                                    }
                                </div>

                                <div class="col-md-7 ps-4">
                                    <h6>Premios de la Categoría</h6>
                                    <ul class="list-group mb-3">
                                        @foreach (var premio in categoria.Premios.OrderBy(p => p.Posicion))
                                        {
                                            <li class="list-group-item d-flex justify-content-between align-items-start">
                                                <div>
                                                    <span class="badge bg-warning text-dark me-2">#@premio.Posicion</span>
                                                    <strong>@premio.Name</strong>
                                                    @if (!string.IsNullOrEmpty(premio.Descripcion))
                                                    {
                                                        <div class="text-muted small mt-1">@premio.Descripcion</div>
                                                    }
                                                </div>
                                                <button class="btn btn-sm text-danger border-0"
                                                        @onclick="() => EliminarPremioConcreto(categoria.Id, premio.Id)">
                                                    <RadzenIcon Icon="delete" />
                                                </button>
                                            </li>
                                        }
                                    </ul>

                                    <div class="bg-light p-3 rounded">
                                        <span class="fw-bold small d-block mb-2">Añadir Nuevo Premio</span>
                                        <div class="row g-2">
                                            <div class="col-3">
                                                <input type="number" class="form-control form-control-sm" placeholder="Puesto" @bind="nuevoPremioPuesto" min="1" />
                                            </div>
                                            <div class="col-9">
                                                <input type="text" class="form-control form-control-sm" placeholder="Nombre (Ej: Cheque 500€)" @bind="nuevoPremioNombre" />
                                            </div>
                                            <div class="col-12">
                                                <input type="text" class="form-control form-control-sm" placeholder="Descripción breve (opcional)" @bind="nuevoPremioDesc" />
                                            </div>

                                            <!-- NUEVO CHECKBOX DE EMPATE -->
                                            <div class="col-12 mt-2 d-flex align-items-center">
                                                <RadzenCheckBox @bind-Value="nuevoPremioPermiteEmpate" Name="chkEmpate" />
                                                <RadzenLabel Text="Admite empate (se entregará a todos los que saquen la misma puntuación)" Component="chkEmpate" class="ms-2 small text-muted" />
                                            </div>

                                            <div class="col-12 text-end mt-2">
                                                <button class="btn btn-sm btn-success px-3" @onclick="() => AgregarPremioConcreto(categoria.Id)">Añadir Premio</button>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Panel de Supervisión de Jueces -->
                                    <div class="mt-3">
                                        <button class="btn btn-sm btn-outline-info w-100" @onclick="() => ToggleSupervision(categoria.Id)">
                                            <RadzenIcon Icon="visibility" class="me-1" /> Votos de  jueces
                                        </button>

                                        @if (supervisionAbierta.ContainsKey(categoria.Id) && supervisionAbierta[categoria.Id])
                                        {
                                            <div class="card mt-2 border-info" style="font-size: 0.85rem;">
                                                <div class="card-header bg-info text-white py-1 px-2 d-flex justify-content-between align-items-center">
                                                    <small><RadzenIcon Icon="groups" class="me-1" /> Jueces asignados</small>
                                                    <button class="btn btn-sm btn-light py-0 px-1" @onclick="() => ToggleSupervision(categoria.Id)">
                                                        <RadzenIcon Icon="close" Style="font-size: 12px;" />
                                                    </button>
                                                </div>
                                                <div class="card-body py-2 px-2">
                                                    <!-- Contador + barra de progreso -->
                                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                                        <small class="fw-bold">Votos: @CompletadosCount(categoria.Id)/@TotalCount(categoria.Id)</small>
                                                        <div class="progress flex-grow-1 mx-2" style="height: 6px;">
                                                            <div class="progress-bar bg-success" style="width: @Porcentaje(categoria.Id)%"></div>
                                                        </div>
                                                    </div>

                                                    <!-- Lista compacta de jueces -->
                                                    @foreach (var juez in JuecesSupervision(categoria.Id))
                                                    {
                                                        <div class="d-flex justify-content-between align-items-center mb-1 py-1 border-bottom">
                                                            <small>
                                                                <RadzenIcon Icon="account_circle" class="me-1 text-secondary" />
                                                                @juez.Nombre
                                                            </small>
                                                            <div class="d-flex align-items-center gap-2">
                                                                <span class="badge @(juez.HaVotado ? "bg-success" : "bg-warning text-dark")" style="font-size: 0.7rem;">
                                                                    @juez.Estado
                                                                </span>
                                                                @if (!juez.HaVotado)
                                                                {
                                                                    <button class="btn btn-sm btn-outline-primary py-0 px-2"
                                                                            @onclick="() => EnviarRecordatorio(juez.JuezId, categoria.Votacion.Id, categoria.Id, categoria.Name, evento.Name)"
                                                                            style="font-size: 0.7rem;">
                                                                        Enviar recordatorio
                                                                    </button>
                                                                }
                                                                
                                                            </div>
                                                        </div>
                                                    }

                                                  
                                                </div>
                                            </div>
                                        }
                                    </div>                            
                                </div>
                            </div>
            </div>
                                }                            
                            </div >                                      
                         </div >                                         
                    }

                    else if (tabActivo == "Participantes")
        {
            <div class="card shadow-sm p-4">
                <h4 class="mb-4">Participantes y Proyectos</h4>

                @foreach (var categoria in evento.CategoriasEvento.ToList())
                {
                    <div class="mb-5">
                        <h5 class="text-primary border-bottom pb-2 mb-3">
                            <RadzenIcon Icon="label" class="fs-5 me-1" /> @categoria.Name
                            <span class="badge bg-secondary ms-2 fs-6">@categoria.Proyectos.Count inscritos</span>
                        </h5>

                        @if (!categoria.Proyectos.Any())
                        {
                            <p class="text-muted fst-italic">Aún no hay proyectos inscritos en esta categoría.</p>
                        }
                        else
                        {
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Nombre del Proyecto</th>
                                        <th>Creador</th>
                                        <th>Tipo de Proyecto</th>
                                        <th>Fecha Inscripción</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var proyecto in categoria.Proyectos.ToList())
                                    {
                                        <tr>
                                            <td class="fw-bold">@proyecto.Name</td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <RadzenIcon Icon="person" class="me-1 text-secondary" />
                                                    @(proyecto.Participante?.Name ?? "Desconocido")
                                                </div>
                                            </td>
                                            <td><span class="badge bg-info text-dark">@proyecto.CategoriaEspecialidad()</span></td>
                                            <td>@proyecto.FechaRegistro.ToShortDateString()</td>
                                            <td>
                                                @if (proyecto.Participante != null)
                                                {
                                                    <button class="btn btn-sm btn-outline-info me-1" title="Ver ficha del participante"
                                                            @onclick='() => NavigationManager.NavigateTo($"/ficha-participante/{proyecto.Participante.Id}")'>
                                                        <RadzenIcon Icon="visibility" Style="font-size: 16px;" /> Ver Ficha
                                                    </button>
                                                }
                                                <button class="btn btn-sm btn-outline-primary me-1 mb-1" title="Editar ficha del proyecto"
                                                        @onclick='() => NavigationManager.NavigateTo($"/participante/editar-proyecto/{proyecto.Id}")'>
                                                    <RadzenIcon Icon="description" Style="font-size: 16px;" /> Proyecto
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger">Descalificar</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                }
            </div>
        }

        @* ---------------------------------------------------- *@
        @* NUEVA SECCIÓN COMPLETA DE ASIGNACIÓN DE JURADO       *@
        @* ---------------------------------------------------- *@
        else if (tabActivo == "Jurado")
        {
            <div class="card shadow-sm p-4">
                <h4 class="mb-4"><RadzenIcon Icon="gavel" class="fs-4 me-2 text-primary" /> Gestión del Jurado del Evento</h4>
                <p class="text-muted">Añade expertos que tendrán permiso para votar y evaluar en todas las categorías de este evento.</p>

                <div class="row mt-4">
                    <div class="col-md-6 border-end">
                        <h6 class="fw-bold mb-3">Vincular nuevo experto</h6>
                        <label class="form-label">Seleccionar Juez registrado en Votify:</label>
                        <div class="input-group mb-3">
                            <select class="form-select" @bind="juezSeleccionadoId">
                                <option value="0">-- Elige un juez del sistema --</option>
                                @foreach (var juez in todosLosJueces)
                                {
                                    <option value="@juez.Id">@juez.Name (@juez.Email)</option>
                                }
                            </select>
                            <button class="btn btn-primary" @onclick="AsignarJuez" disabled="@(juezSeleccionadoId == 0)">
                                Añadir al Evento
                            </button>
                        </div>
                    </div>

                    <div class="col-md-6 ps-4">
                        <h6 class="fw-bold mb-3">Jueces actualmente asignados (@(evento.Jurado?.Count ?? 0))</h6>
                        <ul class="list-group">
                            @if (evento.Jurado != null && evento.Jurado.Any())
                            {
                                @foreach (var asignado in evento.Jurado.ToList())
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span><RadzenIcon Icon="account_circle" class="me-2 text-secondary" /> @asignado.Name</span>
                                        <div>
                                            <small class="text-muted me-3">@asignado.Email</small>
                                            <button class="btn btn-sm btn-outline-danger border-0"
                                                    title="Quitar juez del evento"
                                                    @onclick="() => QuitarJuez(asignado.Id)">
                                                <RadzenIcon Icon="person_remove" />
                                            </button>
                                        </div>
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="list-group-item text-muted text-center fst-italic">Aún no hay jueces asignados a este evento.</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }

        @* NUEVA SECCIÓN COMPLETA DE AUDITORIAS *@

        else if (tabActivo == "Auditoria")
        {
            <div class="card shadow-sm p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4><RadzenIcon Icon="security" class="me-2 text-success" /> Trazabilidad de Votos</h4>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CargarAuditoria">
                        <RadzenIcon Icon="refresh" style="vertical-align: middle;" /> Actualizar
                    </button>
                </div>

                @if (cargandoAuditoria)
                {
                    <div class="text-center py-5">
