    private void EliminarDelRanking(ResultadoIntervenidoResponse categoria, int index)
    {
        var eliminado = categoria.Proyectos[index];
        categoria.Proyectos.RemoveAt(index);
        categoria.ProyectosDisponibles.Add(eliminado);
        RecalcularPosiciones(categoria);
    }

    private void MostrarSelectorAgregar(ResultadoIntervenidoResponse categoria)
    {
        categoriaAgregandoId = categoria.CategoriaId;
        proyectoAAgregarId = 0;
    }

    private void AgregarProyectoAlRanking(ResultadoIntervenidoResponse categoria)
    {
        var proyecto = categoria.ProyectosDisponibles.FirstOrDefault(p => p.ProyectoId == proyectoAAgregarId);
        if (proyecto == null) return;

        proyecto.Posicion = categoria.Proyectos.Count + 1;
        categoria.Proyectos.Add(proyecto);
        categoria.ProyectosDisponibles.Remove(proyecto);

        categoriaAgregandoId = null;
        proyectoAAgregarId = 0;
    }

    private void RecalcularPosiciones(ResultadoIntervenidoResponse categoria)
    {
        for (int i = 0; i < categoria.Proyectos.Count; i++)
        {
            categoria.Proyectos[i].Posicion = i + 1;
        }
    }

    private async Task GuardarTodosLosResultados()
    {
        mensajeExito = null;
        mensajeError = null;

        try
        {
            foreach (var cat in resultadosPorCategoria)
            {
                var requests = cat.Proyectos.Select(p => new GuardarResultadoRequest
                {
                    ProyectoId = p.ProyectoId,
                    Posicion = p.Posicion,
                    PuntajeOriginal = p.Puntaje
                }).ToList();

                await ResultadosService.GuardarResultadosIntervenidosAsync(cat.VotacionId, requests);
            }

            mensajeExito = "Los resultados se han guardado correctamente.";
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al guardar resultados: {ex.Message}";
        }
    }
}