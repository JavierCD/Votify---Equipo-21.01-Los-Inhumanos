@page "/panel-evento-/{EventoId:int}"
@rendermode InteractiveServer

@using Votify.Core.Models
@using Votify.Core.Interfaces
@using Votify.Services.Interfaces
@using Votify.Web.Services
@inject IEventoService EventoService
@inject IParticipanteService ParticipanteService
@inject NavigationManager NavigationManager
@inject UserSession Session

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Mi Panel: <span class="text-primary">@(evento?.Name ?? "Cargando...")</span></h2>
        <button class="btn btn-outline-secondary" @onclick='() => NavigationManager.NavigateTo("/")'>Volver al Inicio</button>
    </div>

    @if (evento == null || participante == null)
    {
        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando...</span></div>
    }
    else
    {
        <ul class="nav nav-tabs mb-4">
            <li class="nav-item">
                <a class="nav-link @(tabActivo == "Resumen" ? "active fw-bold" : "")" @onclick='() => tabActivo = "Resumen"' style="cursor:pointer">
                    <RadzenIcon Icon="info" class="me-1" /> Resumen del Evento
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(tabActivo == "MisProyectos" ? "active fw-bold" : "")" @onclick='() => tabActivo = "MisProyectos"' style="cursor:pointer">
                    <RadzenIcon Icon="rocket_launch" class="me-1" /> Mis Proyectos
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(tabActivo == "Resultados" ? "active fw-bold" : "")" @onclick='() => tabActivo = "Resultados"' style="cursor:pointer">
                    <RadzenIcon Icon="emoji_events" class="me-1" /> Resultados Oficiales
                </a>
            </li>
        </ul>

        @if (tabActivo == "Resumen")
        {
            <div class="card shadow-sm p-4 mb-4">
                <h4 class="mb-3">Información General</h4>
                <p class="text-muted">@evento.Description</p>
                <div class="row mt-4">
                    <div class="col-md-6">
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item"><RadzenIcon Icon="calendar_today" class="me-2 text-primary" /> <strong>Inicio:</strong> @evento.FechaInicio.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</li>
                            <li class="list-group-item"><RadzenIcon Icon="event_busy" class="me-2 text-danger" /> <strong>Fin:</strong> @evento.FechaFin.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-bold">Categorías en competición:</h6>
                        @foreach (var cat in evento.CategoriasEvento)
                        {
                            <span class="badge bg-light text-dark border me-2 mb-2 p-2">@cat.Name</span>
                        }
                    </div>
                </div>
            </div>
        }

        else if (tabActivo == "MisProyectos")
        {
            var misProyectosEnEsteEvento = participante.ObtenerProyectosParaEvento(evento);
            @if (!misProyectosEnEsteEvento.Any())
            {
                <div class="alert alert-warning">No tienes proyectos inscritos en este evento.</div>
            }
            else
            {
                <div class="row">
                    @foreach (var proyecto in misProyectosEnEsteEvento)
                    {
                        <div class="col-12 mb-4">
                            <RadzenCard class="shadow-sm p-4" Style="border-top: 4px solid var(--rz-info);">
                                <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                                    <div>
                                        <h4 class="fw-bold mb-0">@proyecto.Name</h4>
                                        <small class="text-muted">Inscrito el @proyecto.FechaRegistro.ToString("dd/MM/yyyy")</small>
                                    </div>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => NavigationManager.NavigateTo($"/participante/editar-proyecto/{proyecto.Id}"))">
                                        <RadzenIcon Icon="edit" /> Editar
                                    </button>
                                </div>
                                <p>@proyecto.Description</p>

                                <div class="alert alert-light border mt-3 text-center">
                                    <RadzenIcon Icon="bar_chart" Style="font-size: 2rem; color: #ccc;" />
                                    <p class="text-muted small m-0 mt-2">Métricas y evolución de votos (Próximamente)</p>
                                </div>
                            </RadzenCard>
                        </div>
                    }
                </div>
            }
        }

        else if (tabActivo == "Resultados")
        {
            <div class="card shadow-sm p-4">
                <h4 class="mb-3"><RadzenIcon Icon="leaderboard" class="me-2 text-warning" /> Clasificaciones</h4>
                <p class="text-muted small">Los resultados aparecerán aquí conforme la organización cierre las votaciones y publique los ganadores de cada categoría.</p>

                <div class="text-center py-5 border rounded bg-light border-dashed">
                    <RadzenIcon Icon="lock_clock" Style="font-size: 3rem; color: #aaa;" />
                    <h6 class="mt-3 text-muted">Aún no hay resultados públicos para este evento.</h6>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public int EventoId { get; set; }

    private string tabActivo = "Resumen";
    private Evento? evento;
    private Participante? participante;

    protected override async Task OnInitializedAsync()
    {
        // 1. Obtener quién es el usuario conectado
        if (Session.Usuario is Participante part)
        {
            // 2. Cargar el evento específico
            evento = await EventoService.ObtenerEventoConDetallesAsync(EventoId);
            // 3. Cargar los datos del participante (sus proyectos, etc)
            participante = await ParticipanteService.ObtenerDashboardAsync(part.Id);
        }
    }
}