@page "/"
@rendermode InteractiveServer

@using Votify.Core.Factories
@using Votify.Core.Models
@using Votify.Core.Interfaces

@using Votify.Services.Interfaces
@using Votify.Services.Models
@inject IVotoExpertoServices VotoExpertoService
@inject NavigationManager NavigationManager
@inject IEventoService EventoService
@inject IProyectoService ProyectoService
@inject Votify.Web.Services.UserSession Session
@inject IVotoPopularService VotoPopularService
@inject IVotoPuntuacionService VotoPuntuacionService
@inject IVotoMulticriterioService VotoMulticriterioService

<PageTitle>Inicio - Votify</PageTitle>

@* ==========================================
   DASHBOARD PARTICIPANTE
   ========================================== *@
@if (Session.Usuario is Participante)
{
    <div class="container-fluid mt-4 px-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Hola, @NombreUsuario <span class="text-muted fs-5">(Participante)</span></h2>
        </div>

        <div class="row">
            <div class="col-lg-8 pe-lg-4 border-end">

                <h4 class="mb-3"><RadzenIcon Icon="task_alt" class="me-2 text-success" /> Mis Eventos Inscritos</h4>
                @if (!misEventos.Any())
                {
                    <div class="alert alert-light border shadow-sm mb-5 text-muted fst-italic">
                        Aún no te has inscrito en ningún evento. Explora los eventos disponibles abajo o usa un código de invitación.
                    </div>
                }
                else
                {
                    <div class="row g-3 mb-5">
                        @foreach (var ev in misEventos)
                        {
                            <div class="col-md-6">
                                <RadzenCard class="h-100 shadow-sm border-0 border-start border-success border-4" Style="border-radius: 12px;">
                                    <h5 class="mb-1 fw-bold text-dark">@ev.Name</h5>
                                    <p class="text-muted mb-3 small">
                                        <RadzenIcon Icon="date_range" Style="font-size: 0.8rem" /> @ev.FechaInicio.ToLocalTime().ToString("dd MMM yyyy") - @ev.FechaFin.ToLocalTime().ToString("dd MMM yyyy")
                                    </p>
                                    <button class="btn btn-sm btn-success w-100 fw-bold shadow-sm" @onclick='() => NavigationManager.NavigateTo($"/panel-evento/{ev.Id}")'>
                                        <RadzenIcon Icon="dashboard" class="me-1" /> Ir al panel del Evento
                                    </button>
                                </RadzenCard>
                            </div>
                        }
                    </div>
                }

                <h4 class="mb-3"><RadzenIcon Icon="explore" class="me-2 text-primary" /> Eventos Disponibles</h4>
                @if (!eventosDisponibles.Any())
                {
                    <div class="alert alert-info shadow-sm">Actualmente no hay eventos públicos abiertos para inscripción.</div>
                }
                else
                {
                    <div class="row g-3 mb-4">
                        @foreach (var ev in eventosDisponibles)
                        {
                            <div class="col-md-6">
                                <RadzenCard class="h-100 shadow-sm border-0" Style="border-radius: 12px;">
                                    <div class="d-flex mb-3">
                                        <div class="bg-primary text-white d-flex align-items-center justify-content-center rounded" style="width: 50px; height: 50px;">
                                            <RadzenIcon Icon="emoji_events" Style="font-size: 1.8rem" />
                                        </div>
                                        <div class="ms-3">
                                            <h6 class="mb-1 fw-bold text-dark">@ev.Name</h6>
                                            <p class="text-muted mb-0 small">
                                                <RadzenIcon Icon="calendar_today" Style="font-size: 0.8rem" /> Cierra: @ev.FechaFin.ToLocalTime().ToString("dd/MM/yyyy")
                                            </p>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-auto">
                                        <span class="badge bg-light text-primary border">@(ev.CategoriasEvento?.Count ?? 0) Categorías</span>
                                        <button class="btn btn-sm btn-outline-primary fw-bold px-3" @onclick="() => PrepararInscripcion(ev)">
                                            Participar
                                        </button>
                                    </div>
                                </RadzenCard>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="col-lg-4 ps-lg-4">
                <h5 class="mb-3 fw-bold text-secondary">Accesos Rápidos</h5>

                <div class="card p-4 shadow-sm mb-4 border-0" Style="border-radius: 12px; background-color: #f8f9fa;">
                    <h6 class="mb-2 fw-bold"><RadzenIcon Icon="vpn_key" class="me-1 text-primary" /> Inscripción a Evento</h6>
                    <p class="text-muted small mb-3">Únete usando el código proporcionado o seleccionando un evento de la lista.</p>

                    @if (!string.IsNullOrEmpty(mensajeErrorParticipante))
                    {
                        <div class="alert alert-danger p-2 small"><RadzenIcon Icon="error" class="me-1" /> @mensajeErrorParticipante</div>
                    }
                    @if (!string.IsNullOrEmpty(mensajeExitoParticipante))
                    {
                        <div class="alert alert-success p-2 small"><RadzenIcon Icon="check_circle" class="me-1" /> @mensajeExitoParticipante</div>
                    }

                    @if (eventoEncontrado == null)
                    {
                        <input type="text" @bind="codigoBusqueda" placeholder="Ej: HACK26" class="form-control mb-3 text-center fw-bold text-uppercase" />
                        <button class="btn btn-primary w-100 fw-bold shadow-sm" @onclick="BuscarEvento">Validar Código</button>
                    }
                    else
                    {
                        <div class="text-start mt-2">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-success text-start py-2 w-100">Evento: @eventoEncontrado.Name</span>
                                <button class="btn btn-link text-muted p-0 m-0 ms-2" title="Cancelar" @onclick="CancelarInscripcion"><RadzenIcon Icon="close" /></button>
                            </div>

                            <label class="fw-bold small mb-1 mt-2">Nombre del Proyecto *</label>
                            <input type="text" @bind="nombreProyecto" class="form-control form-control-sm mb-2 shadow-sm" />

                            <label class="fw-bold small mb-1">Descripción</label>
                            <textarea @bind="descripcionProyecto" class="form-control form-control-sm mb-2 shadow-sm" rows="2"></textarea>

                            <label class="fw-bold small mb-1">Especialidad *</label>
                            <select @bind="tipoProyectoSeleccionado" class="form-select form-select-sm mb-2 shadow-sm">
                                @foreach (var opcion in opcionesTipoProyecto)
                                {
                                    <option value="@opcion">@opcion</option>
                                }
                            </select>

                            <label class="fw-bold small mb-1">Categoría *</label>
                            <select @bind="categoriaSeleccionadaId" class="form-select form-select-sm mb-3 shadow-sm">
                                <option value="0">Selecciona...</option>
                                @if (eventoEncontrado.CategoriasEvento != null)
                                {
                                    @foreach (var cat in eventoEncontrado.CategoriasEvento)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                }
                            </select>

                            <button class="btn btn-primary w-100 fw-bold shadow-sm" @onclick="InscribirProyecto">
                                <RadzenIcon Icon="rocket_launch" class="me-1" /> Completar Inscripción
                            </button>
                        </div>
                    }
                </div>

                <div class="card p-4 shadow-sm border-0" Style="border-radius: 12px; background-color: #f8f9fa;">
                    <h6 class="mb-2 fw-bold"><RadzenIcon Icon="how_to_vote" class="me-1 text-success" /> Acceso a Votación</h6>
                    <p class="text-muted small mb-3">Introduce el código ID de la votación manual.</p>
                    <input type="number" class="form-control mb-3 text-center fw-bold" placeholder="ID (Ej: 12)" @bind="codigoVotacion" />
                    @if (!string.IsNullOrEmpty(mensajeErrorVotante))
                    {
                        <div class="alert alert-danger p-2 small">@mensajeErrorVotante</div>
                    }
                    <button class="btn btn-success w-100 fw-bold shadow-sm" @onclick="AccederVotacion">Ir a Votar</button>
                </div>
            </div>
        </div>
    </div>
}
@* ==========================================
                DASHBOARD JURADO 
   ========================================== *@
else if (Session.Usuario is Juez juez)
{
    <div class="container-fluid mt-4 px-4">
        <h2 class="mb-4">Hola, @NombreUsuario <span class="text-muted fs-5">(Jurado)</span></h2>
        <div class="row">
            <div class="col-12">
                <h4 class="mb-3"><RadzenIcon Icon="gavel" class="me-2 text-warning" /> Mis Eventos a Evaluar (@eventosJuez.Count)</h4>
                @if (!eventosJuez.Any())
                {
                    <div class="alert alert-light border shadow-sm mb-5 text-muted fst-italic">
                        No tienes eventos asignados por el momento.
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var ev in eventosJuez)
                        {
                            <div class="col-md-6 mb-4">
                                <RadzenCard class="h-100 shadow-sm border-0 border-start border-warning border-4" Style="border-radius: 12px;">
                                    <div class="d-flex mb-3">
                                        <div class="bg-warning text-dark d-flex align-items-center justify-content-center rounded" style="width: 50px; height: 50px;">
                                            <RadzenIcon Icon="balance" Style="font-size: 1.8rem" />
                                        </div>
                                        <div class="ms-3">
                                            <h5 class="mb-1 fw-bold">@ev.Name</h5>
                                            <p class="text-muted mb-1 small">
                                                <RadzenIcon Icon="calendar_today" Style="font-size: 0.8rem" /> @ev.FechaInicio.ToLocalTime().ToString("dd MMM yyyy") - @ev.FechaFin.ToLocalTime().ToString("dd MMM yyyy")
                                            </p>
                                        </div>
                                    </div>
                                    <div class="d-flex flex-column gap-2 mt-auto">
                                        <button class="btn btn-sm btn-outline-dark w-100 fw-bold" @onclick='() => NavigationManager.NavigateTo($"/panel-evento/{ev.Id}")'>
                                            <RadzenIcon Icon="visibility" class="me-1" /> Ver Detalles del Evento
                                        </button>
                                    </div>
                                </RadzenCard>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}
@* ==========================================
   DASHBOARD ORGANIZADOR Y PÚBLICO (Se mantiene intacto)
   ========================================== *@
else if (Session.Usuario is Organizador)
{
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Hola, @NombreUsuario</h2>
            <RadzenButton Text="+ Añadir Evento" Click="@(() => NavigationManager.NavigateTo("/eventos/crear"))" ButtonStyle="ButtonStyle.Primary" />
        </div>

        <h4 class="mb-3">Mis Eventos (@misEventos.Count())</h4>

        <div class="row">
            @foreach (var ev in misEventos)
            {
                <div class="col-md-6 mb-4">
                    <RadzenCard class="h-100 shadow-sm">
                        <div class="d-flex mb-3">
                            <div class="bg-primary text-white d-flex align-items-center justify-content-center rounded" style="width: 80px; height: 80px;">
                                <RadzenIcon Icon="event" Style="font-size: 3rem" />
                            </div>
                            <div class="ms-3">
                                <h5 class="mb-1">@ev.Name</h5>
                                <p class="text-muted mb-1 small">
                                    <RadzenIcon Icon="calendar_today" Style="font-size: 0.8rem" />
                                    @ev.FechaInicio.ToLocalTime().ToString("dd MMM") - @ev.FechaFin.ToLocalTime().ToString("dd MMM yyyy")
                                </p>
                                <div class="mt-2 mb-2 p-2 bg-light border rounded d-flex justify-content-between align-items-center">
                                    <span class="small fw-bold text-muted">Código de invitación:</span>
                                    <span class="badge bg-warning text-dark fs-6 font-monospace" style="letter-spacing: 2px;">@ev.CodigoAcceso</span>
                                </div>
                                <div class="mt-2">
                                    @foreach (var cat in ev.CategoriasEvento)
                                    {
                                        <span class="badge bg-light text-primary border me-1">@cat.Name</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <RadzenButton Text="Modificar" ButtonStyle="ButtonStyle.Light" class="w-100"
                                          Click="@(() => NavigationManager.NavigateTo($"/eventos/editar/{ev.Id}"))" />
                            <RadzenButton Text="Publicar" ButtonStyle="ButtonStyle.Primary" class="w-100" />
                        </div>
                    </RadzenCard>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="container d-flex flex-column align-items-center justify-content-center" style="min-height: 60vh;">
        <h2 class="mb-4">Accede como votante a una votación</h2>
        <div class="card shadow-sm p-4 text-center" style="max-width: 400px; width: 100%;">
            <label class="form-label mb-3">Introduce el código de la votación</label>
            <input type="number" class="form-control mb-3 text-center fs-4"
                   placeholder="Ej: 1"
                   @bind="codigoVotacion" />
            @if (!string.IsNullOrEmpty(mensajeErrorVotante))
            {
                <div class="alert alert-danger small">@mensajeErrorVotante</div>
            }
            <button class="btn btn-primary w-100" @onclick="AccederVotacion">Continuar</button>
        </div>
    </div>
}

@code {
    private string codigoVotacion = "";
    private string? mensajeErrorVotante;

    private async Task AccederVotacion()
    {
        mensajeErrorVotante = null;

        if (string.IsNullOrWhiteSpace(codigoVotacion))
        {
            mensajeErrorVotante = "Introduce un código de votación.";
            return;
        }

        if (!int.TryParse(codigoVotacion, out int id))
        {
            mensajeErrorVotante = "El código debe ser un número.";
            return;
        }

        try
        {
            await VotoPopularService.ObtenerDetallePorIdAsync(id);
            NavigationManager.NavigateTo($"/voto-popular-usuario/{id}");
            return;
        }
        catch { }

        try
        {
            await VotoPuntuacionService.ObtenerDetallePorIdAsync(id);
            NavigationManager.NavigateTo($"/voto-puntuacion-usuario/{id}");
            return;
        }
        catch { }

        try
        {
            await VotoMulticriterioService.ObtenerDetallePorIdAsync(id);
            NavigationManager.NavigateTo($"/voto-multicriterio-usuario/{id}");
            return;
        }
        catch { }

        mensajeErrorVotante = "No se encontró ninguna votación con ese código.";
    }

    private string NombreUsuario = "Invitado";
    private IEnumerable<Evento> misEventos = new List<Evento>();
    private IEnumerable<Evento> eventosDisponibles = new List<Evento>();
    private List<Evento> eventosJuez = new();

    private string codigoBusqueda = "";
    private Evento? eventoEncontrado;
    private string? mensajeErrorParticipante;
    private string? mensajeExitoParticipante;

    private string nombreProyecto = "";
    private string? descripcionProyecto;
    private int categoriaSeleccionadaId;

    private string tipoProyectoSeleccionado = "IA";
    private List<string> opcionesTipoProyecto = new List<string> { "IA", "Sostenibilidad", "Ciberseguridad" };

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosSegunRol();
    }

    private async Task CargarDatosSegunRol()
    {
        if (Session.Usuario is Organizador org)
        {
            NombreUsuario = Session.Usuario.Name;
            misEventos = await EventoService.ObtenerEventosPorOrganizadorAsync(org.Id);
        }
        else if (Session.Usuario is Participante part)
        {
            NombreUsuario = Session.Usuario.Name;
            misEventos = await EventoService.ObtenerEventosPorParticipanteAsync(part.Id);
            eventosDisponibles = await EventoService.ObtenerEventosDisponiblesAsync();
        }
        else if (Session.Usuario is Juez juez)
        {
            NombreUsuario = Session.Usuario.Name;
            eventosJuez = (await EventoService.ObtenerEventosPorJuezAsync(juez.Id)).ToList();
        }
        else
        {
            misEventos = new List<Evento>();
            NombreUsuario = "Votante";
        }
    }

    private async Task BuscarEvento()
    {
        mensajeErrorParticipante = null;
        mensajeExitoParticipante = null;

        if (string.IsNullOrWhiteSpace(codigoBusqueda))
        {
            mensajeErrorParticipante = "Introduce un código de evento.";
            return;
        }

        eventoEncontrado = await EventoService.ObtenerEventoPorCodigoAsync(codigoBusqueda);

        if (eventoEncontrado == null)
        {
            mensajeErrorParticipante = "No hemos encontrado ningún evento con ese código.";
        }
    }

    private void PrepararInscripcion(Evento ev)
    {
        mensajeErrorParticipante = null;
        mensajeExitoParticipante = null;
        eventoEncontrado = ev;
        codigoBusqueda = ev.CodigoAcceso; // Autocompleta el código para la vista de usuario
    }

    private void CancelarInscripcion()
    {
        eventoEncontrado = null;
        codigoBusqueda = "";
        nombreProyecto = "";
        descripcionProyecto = null;
        categoriaSeleccionadaId = 0;
    }

    private async Task InscribirProyecto()
    {
        mensajeErrorParticipante = null;

        if (string.IsNullOrWhiteSpace(nombreProyecto) || categoriaSeleccionadaId == 0)
        {
            mensajeErrorParticipante = "El nombre del proyecto y la categoría son obligatorios.";
            return;
        }

        try
        {
            int participanteId = Session.Usuario.Id;

            ProyectoCreator creator = tipoProyectoSeleccionado switch
            {
                "IA" => new AiProjectCreator(),
                "Sostenibilidad" => new SustainabilityProjectCreator(),
                "Ciberseguridad" => new CybersecurityProjectCreator(),
                _ => new AiProjectCreator() // Fallback
            };

            Proyecto nuevoProyecto = creator.CrearProyecto(nombreProyecto, participanteId, default, default, descripcionProyecto);

            await ProyectoService.CrearProyectoConCategoriaAsync(nuevoProyecto, categoriaSeleccionadaId);

            mensajeExitoParticipante = $"¡Tu proyecto '{nombreProyecto}' fue inscrito exitosamente!";

            // Recargamos los eventos para que aparezca automáticamente a la izquierda
            await CargarDatosSegunRol();

            CancelarInscripcion();
        }
        catch (Exception ex)
        {
            mensajeErrorParticipante = $"Error al inscribir: {ex.Message}";
        }
    }
}